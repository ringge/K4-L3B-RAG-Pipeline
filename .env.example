# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | jina
EMBEDDING_PROVIDER=sentence_transformers
# Used only by sentence_transformers; Jina uses jina-embeddings-v3.
EMBEDDING_MODEL=BAAI/bge-m3
JINA_API_KEY=
JINA_RERANK_URL=
JINA_RERANK_MODEL=

# Optional services
PAGEINDEX_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
